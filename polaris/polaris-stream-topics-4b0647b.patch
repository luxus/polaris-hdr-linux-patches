+      return spa_format == SPA_VIDEO_FORMAT_xBGR_210LE ||
+             spa_format == SPA_VIDEO_FORMAT_BGRx ||
+             spa_format == SPA_VIDEO_FORMAT_BGRA ||
+             spa_format == SPA_VIDEO_FORMAT_RGBx ||
+             spa_format == SPA_VIDEO_FORMAT_RGBA;
+    }
